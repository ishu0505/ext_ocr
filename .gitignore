# ==========================================
# 1. EXT-OCR PROJECT SPECIFIC
# ==========================================
# Ignore all uploaded PDFs, images, and processed outputs
data_ext/uploads/*
data_ext/outputs/*

# BUT keep the folder structures intact in the repo
!data_ext/uploads/.gitkeep
!data_ext/outputs/.gitkeep

# Ignore loose MinerU temp files or stray PyMuPDF crops in the root
*_middle.json
*content_list.json
*.png
*.jpg
*.pdf
*.csv

# ==========================================
# 2. PYTHON & ENVIRONMENTS
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Environments & Secrets (CRITICAL: Never commit GEMINI_API_KEY)
.env
.envrc
.venv
env/
venv/
ENV/

# Note: uv.lock is intentionally NOT ignored here. 
# It is best practice to commit uv.lock to version control 
# so your production server replicates the exact same dependency tree.

# ==========================================
# 3. OS & SYSTEM FILES
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# 4. IDEs & EDITORS
# ==========================================
.vscode/
.idea/
.cursorignore
.cursorindexingignore
*.swp

# ==========================================
# 5. TESTING & LOGS
# ==========================================
*.log
pip-log.txt
.pytest_cache/
.coverage
htmlcov/